<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="URDF_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>my_arm_hardware/PicoInterface</plugin>
            </hardware>
            <joint name="Revolute 7">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 7']}</param>
                </state_interface>
            </joint>
            <joint name="Revolute 8">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 8']}</param>
                </state_interface>
            </joint>
            <joint name="Revolute 10">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 10']}</param>
                </state_interface>
            </joint>
            <joint name="Revolute 11">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 11']}</param>
                </state_interface>
            </joint>
            <joint name="Revolute 12">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 12']}</param>
                </state_interface>
            </joint>
            <joint name="Revolute 13">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute 13']}</param>
                </state_interface>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
